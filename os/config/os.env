# AlliedID 배포판 공통 설정 (모든 빌드 스크립트가 source 한다)
AID_NAME="AlliedID"
AID_VERSION="26.11.1"
AID_CODENAME="allied"
AID_PRETTY="AlliedID 26.11.1 LTS"
AID_USER="aid"
AID_HOSTNAME="alliedid"
UBUNTU_SUITE="noble"            # Ubuntu 24.04 LTS (24.04.5 포인트 릴리스와 같은 저장소)
UBUNTU_MIRROR_AMD64="http://archive.ubuntu.com/ubuntu"
UBUNTU_MIRROR_ARM64="http://ports.ubuntu.com/ubuntu-ports"
# Pi 5 베이스 이미지 (서버 이미지 위에 AlliedID 데스크톱을 올린다)
RPI_RELEASE_URL="https://cdimage.ubuntu.com/releases/noble/release"
RPI_IMAGE_PATTERN='ubuntu-24\.04(\.[0-9]+)?-preinstalled-server-arm64\+raspi\.img\.xz'
RPI_EXTRA_GB=6
