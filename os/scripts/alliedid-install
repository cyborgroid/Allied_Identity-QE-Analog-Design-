#!/bin/bash
# AlliedID 디스크 설치기 (라이브 ISO → VMware 가상 디스크 / PC 디스크)
#   sudo alliedid-install /dev/sda
# 디스크 전체를 지우고 GPT(BIOS+UEFI 겸용)로 설치한다.
set -euo pipefail
DISK="${1:-}"
die() { echo "alliedid-install: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "root 로 실행하세요 (라이브 세션: sudo alliedid-install /dev/sdX)"
[[ -b "$DISK" ]] || { lsblk -d -o NAME,SIZE,MODEL,TYPE | grep -v loop; die "사용법: alliedid-install /dev/<디스크>"; }
SQ=$(ls /cdrom/casper/filesystem.squashfs /run/live/medium/casper/filesystem.squashfs 2>/dev/null | head -1) || true
[[ -f "$SQ" ]] || die "라이브 매체의 filesystem.squashfs 를 찾을 수 없습니다"

lsblk "$DISK"
read -r -p "⚠ $DISK 의 모든 데이터가 지워집니다. 계속하려면 디스크 이름($(basename "$DISK"))을 입력: " ans
[[ "$ans" == "$(basename "$DISK")" ]] || die "취소됨"

part() { [[ "$DISK" =~ [0-9]$ ]] && echo "${DISK}p$1" || echo "${DISK}$1"; }
wipefs -a "$DISK"
parted -s "$DISK" mklabel gpt \
  mkpart bios 1MiB 2MiB set 1 bios_grub on \
  mkpart ESP fat32 2MiB 514MiB set 2 esp on \
  mkpart root ext4 514MiB 100%
partprobe "$DISK"; udevadm settle
mkfs.vfat -F32 -n EFI "$(part 2)"
mkfs.ext4 -F -L alliedid "$(part 3)"

T=/mnt/alliedid-target
mkdir -p "$T"; mount "$(part 3)" "$T"
echo "파일 복사 중… (몇 분 걸립니다)"
unsquashfs -f -d "$T" "$SQ"
mkdir -p "$T/boot/efi"; mount "$(part 2)" "$T/boot/efi"
cat > "$T/etc/fstab" <<FSTAB
UUID=$(blkid -s UUID -o value "$(part 3)") /         ext4 errors=remount-ro 0 1
UUID=$(blkid -s UUID -o value "$(part 2)") /boot/efi vfat umask=0077        0 1
FSTAB
for d in dev dev/pts proc sys run; do mount --bind "/$d" "$T/$d"; done
chroot "$T" /bin/bash -euc '
  dpkg --purge casper 2>/dev/null || true
  rm -f /etc/casper.conf /usr/sbin/alliedid-install
  truncate -s 0 /etc/machine-id
  update-initramfs -u -k all
  grub-install --target=i386-pc '"$DISK"'
  grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --no-nvram
  [ -f /etc/default/grub ] || printf "GRUB_DEFAULT=0\nGRUB_TIMEOUT=3\nGRUB_CMDLINE_LINUX_DEFAULT=\"quiet splash\"\nGRUB_CMDLINE_LINUX=\"\"\n" > /etc/default/grub
  if grep -q "^GRUB_DISTRIBUTOR=" /etc/default/grub; then sed -i "s/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR=AlliedID/" /etc/default/grub; else echo "GRUB_DISTRIBUTOR=AlliedID" >> /etc/default/grub; fi
  update-grub
'
for d in run sys proc dev/pts dev; do umount "$T/$d"; done
umount "$T/boot/efi" "$T"
echo "✓ 설치 완료. ISO 를 빼고 재부팅하면 첫 부팅에서 기기 번호가 만들어집니다."
